{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'The course site is static: nothing to install'",
  "buildCommand": "echo 'The course site is static: nothing to build'",
  "outputDirectory": ".",
  "redirects": [{ "source": "/", "destination": "/site/", "permanent": false }],
  "headers": [
    {
      "source": "/README.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/(.*)/README.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
