<?xml version="1.0" encoding="UTF-8"?>

<!--
  The dashboard's layout. Open it in Scene Builder to drag things around,
  or edit it here. Each fx:id matches an @FXML field in DashboardController.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.boxoffice.desktop.DashboardController"
            styleClass="dashboard">
    <top>
        <HBox styleClass="header" spacing="16">
            <VBox>
                <Label fx:id="title" styleClass="title"/>
                <Label fx:id="when" styleClass="when"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox styleClass="takings-box">
                <Label text="Takings" styleClass="caption"/>
                <Label fx:id="takings" styleClass="takings"/>
                <Label fx:id="soldCount" styleClass="when"/>
            </VBox>
        </HBox>
    </top>
    <left>
        <VBox spacing="8" prefWidth="380">
            <padding>
                <Insets top="16" right="8" bottom="16" left="16"/>
            </padding>
            <Label text="Tickets" styleClass="caption"/>
            <ListView fx:id="types" styleClass="types" prefHeight="96"/>
            <Label text="Sell a ticket" styleClass="caption"/>
            <ChoiceBox fx:id="typeChoice" maxWidth="Infinity"/>
            <TextField fx:id="buyerField" promptText="Buyer's name"/>
            <Button fx:id="sellButton" text="Sell" defaultButton="true" maxWidth="Infinity" styleClass="sell"/>
            <Label fx:id="message" styleClass="message" wrapText="true"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="16" right="16" bottom="16" left="8"/>
            </padding>
            <Label text="Sales, newest first" styleClass="caption"/>
            <TableView fx:id="salesTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No sales yet"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="codeColumn" text="Ticket"/>
                    <TableColumn fx:id="typeColumn" text="Type"/>
                    <TableColumn fx:id="buyerColumn" text="Buyer"/>
                    <TableColumn fx:id="priceColumn" text="Price"/>
                    <TableColumn fx:id="timeColumn" text="Time"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
